# Obsidian Atelier — Design Agency Studio Hub
# Deployment configuration mapping (values intentionally left blank).
# Copy to `.env` and fill in before deploying.

# Client workspace session token key (localStorage)
VITE_SESSION_TOKEN_KEY=app_secure_session_token

# Studio asset CDN origin used by the Asset Vault
STUDIO_CDN_ORIGIN=

# Design API credentials
STUDIO_API_KEY=
STUDIO_API_URL=

# Transactional email (engagement receipts)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Optional analytics
ANALYTICS_ID=
